<span id="cb8-4"><a href="#cb8-4" aria-hidden="true" tabindex="-1"></a>  <span class="cf">await</span> <span class="fu">syncCartToDatabase</span>(items<span class="op">,</span> jwt)<span class="op">;</span></span>
