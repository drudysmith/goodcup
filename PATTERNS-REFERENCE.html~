Preparation</h3>
<div class="sourceCode" id="cb19"><pre
class="sourceCode typescript"><code class="sourceCode typescript"><span id="cb19-1"><a href="#cb19-1" aria-hidden="true" tabindex="-1"></a><span class="co">//   Include visitor_id in Stripe metadata</span></span>
<span id="cb19-2"><a href="#cb19-2" aria-hidden="true" tabindex="-1"></a><span class="kw">const</span> session <span class="op">=</span> <span class="cf">await</span> stripe<span class="op">.</span><span class="at">checkout</span><span class="op">.</span><span class="at">sessions</span><span class="op">.</span><span class="fu">create</span>({</span>
