<span id="cb19-8"><a href="#cb19-8" aria-hidden="true" tabindex="-1"></a>})<span class="op">;</span></span></code></pre></div>
<h3 id="tanstack-query-pattern">TanStack Query Pattern</h3>
<div class="sourceCode" id="cb20"><pre
class="sourceCode typescript"><code class="sourceCode typescript"><span id="cb20-1"><a href="#cb20-1" aria-hidden="true" tabindex="-1"></a><span class="co">//   Query pattern to follow</span></span>
<span id="cb20-2"><a href="#cb20-2" aria-hidden="true" tabindex="-1"></a><span class="kw">const</span> { data<span class="op">:</span> visitorData<span class="op">,</span> isLoading } <span class="op">=</span> <span class="fu">useQuery</span>({</span>
<span id="cb20-3"><a href="#cb20-3" aria-hidden="true" tabindex="-1"></a>  queryKey<span class="op">:</span> [<span class="st">&#39;visitor&#39;</span><span class="op">,</span> visitorId]<span class="op">,</span></span>
<span id="cb20-4"><a href="#cb20-4" aria-hidden="true" tabindex="-1"></a>  queryFn<span class="op">:</span> () <span class="kw">=&gt;</span> <span class="fu">fetchVisitorData</span>(visitorId)<span class="op">,</span></span>
<span id="cb20-5"><a href="#cb20-5" aria-hidden="true" tabindex="-1"></a>  enabled<span class="op">:</span> <span class="op">!!</span>visitorId <span class="op">&amp;&amp;</span> <span class="op">!!</span>jwt<span class="op">,</span>  <span class="co">// Only run when authenticated</span></span>
<span id="cb20-6"><a href="#cb20-6" aria-hidden="true" tabindex="-1"></a>  staleTime<span class="op">:</span> <span class="dv">5</span> <span class="op">*</span> <span class="dv">60</span> <span class="op">*</span> <span class="dv">1000</span><span class="op">,</span>       <span class="co">// 5 minutes</span></span>
<span id="cb20-7"><a href="#cb20-7" aria-hidden="true" tabindex="-1"></a>  retry<span class="op">:</span> (failureCount<span class="op">,</span> error) <span class="kw">=&gt;</span> {</span>
<span id="cb20-8"><a href="#cb20-8" aria-hidden="true" tabindex="-1"></a>    <span class="co">// Don&#39;t retry on auth errors</span></span>
<span id="cb20-9"><a href="#cb20-9" aria-hidden="true" tabindex="-1"></a>    <span class="cf">if</span> (error<span class="op">.</span><span class="at">status</span> <span class="op">===</span> <span class="dv">401</span>) <span class="cf">return</span> <span class="kw">false</span><span class="op">;</span></span>
<span id="cb20-10"><a href="#cb20-10" aria-hidden="true" tabindex="-1"></a>    <span class="cf">return</span> failureCount <span class="op">&lt;</span> <span class="dv">2</span><span class="op">;</span></span>
<span id="cb20-11"><a href="#cb20-11" aria-hidden="true" tabindex="-1"></a>  }</span>
<span id="cb20-12"><a href="#cb20-12" aria-hidden="true" tabindex="-1"></a>})<span class="op">;</span></span></code></pre></div>
