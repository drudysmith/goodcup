<span id="cb9-7"><a href="#cb9-7" aria-hidden="true" tabindex="-1"></a>    acc<span class="op">.</span><span class="fu">push</span>({ <span class="op">...</span>item })<span class="op">;</span>           <span class="co">// Add new item</span></span>
<span id="cb9-8"><a href="#cb9-8" aria-hidden="true" tabindex="-1"></a>  }</span>
<span id="cb9-9"><a href="#cb9-9" aria-hidden="true" tabindex="-1"></a>  <span class="cf">return</span> acc<span class="op">;</span></span>
