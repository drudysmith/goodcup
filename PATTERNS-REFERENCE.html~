<span id="cb9-3"><a href="#cb9-3" aria-hidden="true" tabindex="-1"></a>  <span class="kw">const</span> found <span class="op">=</span> acc<span class="op">.</span><span class="fu">find</span>(i <span class="kw">=&gt;</span> i<span class="op">.</span><span class="at">priceId</span> <span class="op">===</span> item<span class="op">.</span><span class="at">priceId</span>)<span class="op">;</span></span>
